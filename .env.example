# BeeBotOS local secrets. Copy to .env and fill real values.

# Required in production. Use a random 32+ character value.
BEE__JWT__SECRET=change-me-at-least-32-characters

# Default LLM provider: deepseek.
DEEPSEEK_API_KEY=change-me

# Optional model providers.
KIMI_API_KEY=
ZHIPU_API_KEY=
DOUBAO_API_KEY=
OPENAI_API_KEY=

# Optional channel secrets.
BEE__CHANNELS__LARK__APP_SECRET=
BEE__CHANNELS__WECHAT__CORP_SECRET=
BEE__CHANNELS__WECHAT__TOKEN=
BEE__CHANNELS__WECHAT__ENCODING_AES_KEY=

# Optional media generation.
IMAGE_GENERATION_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=doubao-seedream-5.0-lite
IMAGE_UNDERSTANDING_API_KEY=
VIDEO_GENERATION_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VIDEO_GENERATION_API_KEY=
VIDEO_GENERATION_MODEL=doubao-seedance-2.0

BEE_ALLOW_NETWORK=1
INTERNAL_SERVICE_TOKEN=change-me-at-least-32-characters
