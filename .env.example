# BeeBotOS 敏感配置（不要提交到 Git）
# 前缀 BEE 与 config crate 的分隔符 __ 配合，对应 TOML 的层级结构
# 注意：变量名格式为 BEE__{SECTION}__{KEY}（BEE 后紧跟双下划线）

# JWT 签名密钥（至少 32 位字符）
BEE__JWT__SECRET=12s2dfHd8ksd0Lkd789gHjyIRT87XX0998dfDLL9hMGEss33Whlfk783jf00bfdhs3lkdKKL9

# Kimi 大模型 API 密钥
BEE__MODELS__KIMI__API_KEY=xxxx

# Zhipu 大模型 API 密钥
BEE__MODELS__ZHIPU__API_KEY=xxxx

# DeepSeek 大模型 API 密钥
BEE__MODELS__DEEPSEEK__API_KEY=xxxx

# 火山方舟 Agent Plan 文本模型 API 密钥
BEE__MODELS__DOUBAO__API_KEY=xxxx

# 飞书（Lark）应用密钥
BEE__CHANNELS__LARK__APP_SECRET=xxxx

# 企业微信 CorpSecret
BEE__CHANNELS__WECHAT__CORP_SECRET=xxxx
# 企业微信 Token
BEE__CHANNELS__WECHAT__TOKEN=xxxx
# 企业微信消息加解密密钥
BEE__CHANNELS__WECHAT__ENCODING_AES_KEY=xxxx

GPT4_API_KEY=xxxx

BEE_ALLOW_NETWORK=1

# 火山方舟 Agent Plan 视觉生成 API 密钥
IMAGE_GENERATION_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
IMAGE_GENERATION_API_KEY=xxxx
IMAGE_GENERATION_MODEL=doubao-seedream-5.0-lite
VIDEO_GENERATION_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VIDEO_GENERATION_API_KEY=xxxx
VIDEO_GENERATION_MODEL=doubao-seedance-2.0

#通用测试key
FRED_API_KEY=abcdefghijklmnopqrstuvwxyz123456

# 方式 1：openssl（推荐，64 位十六进制 = 256 bit 熵）
# openssl rand -hex 32
# 输出示例：a3f7c9d2e1b8f4a5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b

# 生产环境必须设置CRON （推荐 32+ 字符随机字符串）
# CRON_TOOL_API_TOKEN="your-256-bit-random-token-here"
# 或共享内部 token FOR CRON
INTERNAL_SERVICE_TOKEN=07774e9da8c995288cfd81578c8e4d296b2ae3e35a0334ec223fac2d55e3fe64
